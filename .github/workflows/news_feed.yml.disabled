name: XRP Intelligence Feed

on:
  workflow_dispatch:
  schedule:
    - cron: "*/15 * * * *"

concurrency:
  group: xrp-intelligence-feed
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Restore persistent state
        uses: actions/cache/restore@v4
        with:
          path: |
            state/seen.json
            state/discovery.json
          key: xrp-state-${{ github.ref_name }}-v1-bootstrap
          restore-keys: |
            xrp-state-${{ github.ref_name }}-v1-
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python -m pip install -r requirements.txt
      - run: python -m pytest -q
      - run: python main.py
      - name: Save persistent state
        if: success()
        uses: actions/cache/save@v4
        with:
          path: |
            state/seen.json
            state/discovery.json
          key: xrp-state-${{ github.ref_name }}-v1-${{ hashFiles('state/seen.json', 'state/discovery.json') }}
